# Copy to .env and fill in. Never commit .env.

# Postgres. Locally any Postgres 16+; in production a Neon pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/creatordesk"
# Neon only: the direct (unpooled) URL, used for migrations.
DATABASE_URL_UNPOOLED=""
# Integration tests. Must name a *_test database; it is wiped on every test run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/creatordesk_test"

# Encrypts PAN at rest (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a backup: if this key is lost, stored PANs cannot be read.
DATA_ENCRYPTION_KEY=""
# Number of proxies in front of the app (Render: 1). Used to read the real client IP for rate limits.
TRUSTED_PROXY_HOPS="1"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""
# Passwordless email login for local development only. Ignored in production builds.
AUTH_DEV_LOGIN="true"
# Google sign-in (free): https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (free tier): email sign-in links and the daily summary email.
# Use a sender on a domain you verified in Resend; onboarding@resend.dev only delivers to your own address.
AUTH_RESEND_KEY=""
RESEND_API_KEY=""
RESEND_FROM="CreatorDesk <hello@yourdomain.in>"

# Daily summary job: the scheduler sends "Authorization: Bearer <CRON_SECRET>". Generate a long random string.
CRON_SECRET=""
# Public URL of the app, used for links in emails.
APP_URL="http://localhost:3000"

# AI brief reading (Google Gemini, free tier: https://aistudio.google.com/apikey).
# Each workspace owner must also switch AI on in Settings. Free-tier inputs may be used by Google to improve its products;
# use a paid key before onboarding real customers.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
